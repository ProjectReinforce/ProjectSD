{
  "permissions": {
    "allow": [
      "Read(Assets/**)",
      "Read(docs/**)",
      "Read(Packages/**)",
      "Read(ProjectSettings/**)",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Write(Library/**)",
      "Write(Temp/**)",
      "Write(obj/**)",
      "Write(Logs/**)",
      "Write(UserSettings/**)",
      "Write(Builds/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)"
    ]
  }
}
